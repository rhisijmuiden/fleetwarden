<Project Sdk="Microsoft.NET.Sdk">
  <!-- Custom actions for the agent MSI wizard (connection test). Built on
       Windows by CI; produces FleetWardenCA.CA.dll for the Binary table. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>FleetWardenCA</AssemblyName>
    <RootNamespace>FleetWarden.Installer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
